{"meta":{"scope":"full","scope_label":"Full dataset","is_sample":false,"n_rows":13979592,"full_dataset_rows":13979592,"dataset":"Criteo Uplift Prediction Dataset v2.1","dataset_version":"v2.1","raw_sha256":"2716e1bf0fd157a93b5bf86924d9088419dfbac2022c6cd90030220634f616dc","license":"CC BY-NC-SA 4.0","seed":20240612,"code_version":"0.1.0","generated_at":"2026-10-14T02:16:49+00:00"},"id":"08_segment_treatment_effects","title":"Segment-level treatment effects","technique":"Self-join of arm statistics, per-segment standard errors, cohort comparison","question":"How does the visit effect differ across feature segments?","requires":[],"sql":"-- title: Segment-level treatment effects\n-- technique: Self-join of arm statistics, per-segment standard errors, cohort comparison\n-- question: How does the visit effect differ across feature segments?\nWITH arms AS (\n    SELECT\n        t.feature, t.segment_id, t.segment,\n        least(t.value_min, c.value_min)     AS value_min,\n        greatest(t.value_max, c.value_max)  AS value_max,\n        t.n_users::DOUBLE AS n_t, c.n_users::DOUBLE AS n_c,\n        t.visits / t.n_users::DOUBLE        AS p_t,\n        c.visits / c.n_users::DOUBLE        AS p_c\n    FROM v_segment_arm_stats t\n    JOIN v_segment_arm_stats c\n      ON t.feature = c.feature AND t.segment_id = c.segment_id\n     AND t.treatment = 1 AND c.treatment = 0\n)\nSELECT\n    feature,\n    segment,\n    round(value_min, 3)                                         AS value_min,\n    round(value_max, 3)                                         AS value_max,\n    (n_t + n_c)::BIGINT                                         AS n_users,\n    round(p_c, 5)                                               AS control_visit_rate,\n    round(p_t, 5)                                               AS treatment_visit_rate,\n    round(p_t - p_c, 5)                                         AS absolute_effect,\n    round(sqrt(p_t * (1 - p_t) / n_t + p_c * (1 - p_c) / n_c), 5) AS std_error,\n    round((p_t - p_c) / nullif(p_c, 0), 3)                      AS relative_effect\nFROM arms\nORDER BY CAST(substr(feature, 2) AS INTEGER), segment_id;\n","status":"ok","columns":["feature","segment","value_min","value_max","n_users","control_visit_rate","treatment_visit_rate","absolute_effect","std_error","relative_effect"],"rows":[["f0","Modal value",12.616,12.616,3705545,0.05164,0.05333,0.0017,0.00032,0.033],["f0","Non-modal: low",12.616,22.02,3424686,0.07365,0.10873,0.03508,0.00042,0.476],["f0","Non-modal: mid",22.02,24.511,3424677,0.01624,0.0185,0.00227,0.00019,0.14],["f0","Non-modal: high",24.511,26.745,3424684,0.01182,0.01265,0.00083,0.00016,0.07],["f1","Modal value",10.06,10.06,13807642,0.0368,0.04568,0.00889,0.00014,0.242],["f1","Non-modal: mid",10.68,10.68,123236,0.15623,0.23969,0.08346,0.0032,0.534],["f1","Non-modal: high",11.119,16.344,48714,0.2328,0.34861,0.11581,0.00608,0.497],["f2","Modal value",8.214,8.214,7303429,0.00096,0.0015,0.00054,3e-05,0.561],["f2","Non-modal: low",8.214,8.589,2225386,0.20609,0.24716,0.04107,0.00078,0.199],["f2","Non-modal: mid",8.589,8.874,2225388,0.03042,0.0415,0.01108,0.00033,0.364],["f2","Non-modal: high",8.874,9.052,2225389,0.00727,0.0099,0.00263,0.00016,0.362],["f3","Modal value",4.68,4.68,11443995,0.0281,0.02995,0.00185,0.00014,0.066],["f3","Non-modal: low",-8.398,1.267,827178,0.12076,0.19989,0.07913,0.0011,0.655],["f3","Non-modal: mid",1.433,2.935,825957,0.08592,0.1185,0.03257,0.0009,0.379],["f3","Non-modal: high",3.36,3.908,882462,0.06213,0.07762,0.01549,0.00073,0.249],["f4","Modal value",10.281,10.281,13372695,0.02791,0.03605,0.00814,0.00013,0.292],["f4","Non-modal: low",11.03,11.03,347250,0.21338,0.25707,0.04369,0.00201,0.205],["f4","Non-modal: mid",11.561,11.561,98887,0.29828,0.34882,0.05054,0.0042,0.169],["f4","Non-modal: high",11.973,21.124,160760,0.3978,0.44444,0.04664,0.00347,0.117],["f5","Modal value",4.115,4.115,13238149,0.03484,0.04196,0.00712,0.00014,0.204],["f5","Non-modal: low",-9.012,2.231,257801,0.14913
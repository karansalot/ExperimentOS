{"meta":{"scope":"dev_sample","scope_label":"Development sample (~5%)","is_sample":true,"n_rows":699206,"full_dataset_rows":13979592,"dataset":"Criteo Uplift Prediction Dataset v2.1","dataset_version":"v2.1","raw_sha256":"2716e1bf0fd157a93b5bf86924d9088419dfbac2022c6cd90030220634f616dc","license":"CC BY-NC-SA 4.0","seed":20240612,"code_version":"0.1.0","generated_at":"2026-10-14T02:16:49+00:00"},"id":"08_segment_treatment_effects","title":"Segment-level treatment effects","technique":"Self-join of arm statistics, per-segment standard errors, cohort comparison","question":"How does the visit effect differ across feature segments?","requires":[],"sql":"-- title: Segment-level treatment effects\n-- technique: Self-join of arm statistics, per-segment standard errors, cohort comparison\n-- question: How does the visit effect differ across feature segments?\nWITH arms AS (\n    SELECT\n        t.feature, t.segment_id, t.segment,\n        least(t.value_min, c.value_min)     AS value_min,\n        greatest(t.value_max, c.value_max)  AS value_max,\n        t.n_users::DOUBLE AS n_t, c.n_users::DOUBLE AS n_c,\n        t.visits / t.n_users::DOUBLE        AS p_t,\n        c.visits / c.n_users::DOUBLE        AS p_c\n    FROM v_segment_arm_stats t\n    JOIN v_segment_arm_stats c\n      ON t.feature = c.feature AND t.segment_id = c.segment_id\n     AND t.treatment = 1 AND c.treatment = 0\n)\nSELECT\n    feature,\n    segment,\n    round(value_min, 3)                                         AS value_min,\n    round(value_max, 3)                                         AS value_max,\n    (n_t + n_c)::BIGINT                                         AS n_users,\n    round(p_c, 5)                                               AS control_visit_rate,\n    round(p_t, 5)                                               AS treatment_visit_rate,\n    round(p_t - p_c, 5)                                         AS absolute_effect,\n    round(sqrt(p_t * (1 - p_t) / n_t + p_c * (1 - p_c) / n_c), 5) AS std_error,\n    round((p_t - p_c) / nullif(p_c, 0), 3)                      AS relative_effect\nFROM arms\nORDER BY CAST(substr(feature, 2) AS INTEGER), segment_id;\n","status":"ok","columns":["feature","segment","value_min","value_max","n_users","control_visit_rate","treatment_visit_rate","absolute_effect","std_error","relative_effect"],"rows":[["f0","Modal value",12.616,12.616,185781,0.05289,0.05319,0.0003,0.00144,0.006],["f0","Non-modal: low",12.616,22.021,171142,0.07559,0.10698,0.0314,0.00188,0.415],["f0","Non-modal: mid",22.021,24.51,171141,0.01616,0.01838,0.00222,0.00086,0.138],["f0","Non-modal: high",24.51,26.745,171142,0.01199,0.01213,0.00014,0.00074,0.011],["f1","Modal value",10.06,10.06,690706,0.03762,0.04512,0.0075,0.00065,0.199],["f1","Non-modal: mid",10.68,10.68,6104,0.14567,0.24204,0.09637,0.01406,0.662],["f1","Non-modal: high",11.119,15.641,2396,0.2566,0.33881,0.0822,0.02872,0.32],["f2","Modal value",8.214,8.214,364629,0.00087,0.00133,0.00046,0.00014,0.525],["f2","Non-modal: low",8.214,8.589,111526,0.20785,0.24487,0.03702,0.00348,0.178],["f2","Non-modal: mid",8.589,8.874,111525,0.03175,0.04062,0.00886,0.0015,0.279],["f2","Non-modal: high",8.874,9.052,111526,0.0078,0.00948,0.00168,0.00075,0.215],["f3","Modal value",4.68,4.68,572630,0.02876,0.02971,0.00094,0.00062,0.033],["f3","Non-modal: low",-6.239,1.267,41050,0.12104,0.1963,0.07527,0.005,0.622],["f3","Non-modal: mid",1.433,2.935,41258,0.08935,0.11666,0.02731,0.00408,0.306],["f3","Non-modal: high",3.36,3.908,44268,0.064,0.0772,0.0132,0.00332,0.206],["f4","Modal value",10.281,10.281,668379,0.02847,0.03555,0.00708,0.00058,0.249],["f4","Non-modal: low",11.03,11.03,17585,0.21044,0.25244,0.042,0.00885,0.2],["f4","Non-modal: mid",11.561,11.561,5009,0.29545,0.34874,0.05329,0.01821,0.18],["f4","Non-modal: high",11.973,20.228,8233,0.40342,0.42687,0.02345,0.0155,0.058],["f5","Modal value",4.115,4.115,662262,0.03574,0.04163,0.00589,0.00065,0.165],["f5","Non-modal: low",-8.912,2.231,12816,0.16077,0.22963,0.0688